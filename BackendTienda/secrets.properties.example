# ============================================================
#  AltaPinta - Plantilla de secretos
#
#  Copiala como "secrets.properties" en esta misma carpeta y rellena
#  los valores. El archivo real esta en .gitignore y NUNCA se sube.
#
#  PowerShell:
#    Copy-Item secrets.properties.example secrets.properties
#
#  En un servidor de verdad no uses este archivo: define las mismas
#  claves como variables de entorno, que tienen prioridad sobre el.
# ============================================================

# ---------- Base de datos ----------
# Dejalo vacio si tu MySQL local no tiene password para root.
DB_USERNAME=root
DB_PASSWORD=

# Opcionales: solo si tu MySQL no esta en localhost:3306/alta_pinta
#DB_HOST=localhost
#DB_PORT=3306
#DB_NAME=alta_pinta

# ---------- Correo ----------
# MAIL_PASSWORD NO es la contrasena de la cuenta de Google: es una
# "App Password" de 16 caracteres que se genera en
# https://myaccount.google.com/apppasswords
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxx

# ---------- JWT ----------
# Cadena larga y aleatoria. Generala con:
#   PowerShell:  [Convert]::ToBase64String((1..64 | % { Get-Random -Max 256 }))
#   Git Bash:    openssl rand -base64 64
# Si cambias este valor, todas las sesiones abiertas se invalidan.
JWT_SECRET=GENERA_UN_SECRETO_LARGO_Y_ALEATORIO

# Duracion del token en milisegundos (86400000 = 24 horas)
#JWT_EXPIRATION=86400000

# ---------- Cuenta administradora ----------
# El cliente que se registre con este correo recibe ROLE_ADMIN.
ADMIN_EMAIL=tu_correo@gmail.com
