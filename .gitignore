# ============================================================
#  AltaPinta - Tienda deportiva
#  Backend: Spring Boot 3 (BackendTienda/)  |  Frontend: Angular 20 (Practica/)
# ============================================================

# ------------------------------------------------------------
# SECRETOS  -- nunca subir credenciales al repositorio
# ------------------------------------------------------------
# application.properties SI se versiona: solo tiene referencias
# ${VARIABLE}, ningun valor sensible.
# Los secretos reales (password de Gmail, secreto JWT, credenciales de
# MySQL) viven solo en tu maquina, en secrets.properties. Para clonar el
# proyecto se copia secrets.properties.example -> secrets.properties.
BackendTienda/secrets.properties
secrets.properties
!secrets.properties.example
*.env
.env
.env.local

# ------------------------------------------------------------
# BACKEND - Java / Maven / Spring Boot
# ------------------------------------------------------------
target/
bin/
!.mvn/wrapper/maven-wrapper.jar
HELP.md

# Volcados de crash de la JVM
hs_err_pid*.log
replay_pid*.log

# Respaldos de base de datos: llevan datos de clientes y pedidos, y pesan.
# Guardalos fuera del repositorio.
respaldo-*.sql
*.dump.sql

# Datos generados en tiempo de ejecucion.
# OJO: no se versionan, pero NO los borres de tu disco: la base de datos
# guarda las rutas en producto_imagen.url y factura.url_pdf.
BackendTienda/facturas/

# Se ignora el CONTENIDO de productos-imagenes, no la carpeta: git no
# puede volver a incluir un archivo si su directorio esta excluido, y
# abajo hay una excepción.
BackendTienda/productos-imagenes/*

# Excepción: las ilustraciones de prenda SÍ se versionan. No son datos
# subidos por nadie, son parte del aspecto de la tienda: las genera
# migraciones/generar_imagenes.py y pesan 28 KB entre las 54.
!BackendTienda/productos-imagenes/prenda-*.svg

# Excepción: las fotografías del catálogo también se versionan, porque la
# migración V5 apunta a ellas y sin los archivos un clon limpio mostraría
# el catálogo roto.
#
# IMPORTANTE: son imágenes de referencia de terceros, no propias. Ver la
# nota de atribución en el README antes de darles cualquier otro uso.
!BackendTienda/productos-imagenes/foto-*.jpg
!BackendTienda/productos-imagenes/foto-*.webp

# ------------------------------------------------------------
# FRONTEND - Angular / Node
# ------------------------------------------------------------
node_modules/
dist/
tmp/
out-tsc/
bazel-out/
.angular/
npm-debug.log*
yarn-error.log*
coverage/
testem.log
/typings

# ------------------------------------------------------------
# IDEs y editores
# ------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.classpath
.project
.settings/
.apt_generated
.factorypath
.springBeans
.sts4-cache
*.sublime-workspace
.history/

# ------------------------------------------------------------
# Documentos exportados / material que no es codigo
# ------------------------------------------------------------
# Export HTML de Word (~20 MB de bundles de Office Online). No es codigo
# y no deberia vivir dentro de src/. Ver nota en el README.
Practica/src/img/

# ------------------------------------------------------------
# Sistema operativo
# ------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
